<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/styles.css">
    <title>Inventory</title>
</head>
<body>
    <%- include(links.nav) %>
    <div class="formContainer">
        <form  class="form" method="POST" action=<%=links.href%>>
            <h1>Product Data</h1>
            <%- include("errors.ejs") %>
            <div class="dataInsert">
                <% if(catList) {%>                    
                    <label for="categoryName">Parent Category
                        <select name="categoryName" class="dropdown" >
                            <% catList.forEach((category) => { %>
                                <option value="<%=category.name %>"><%= category.name%></option>
                            <% }); %>
                        </select>
                    </label>
                <% } %>
                <div class="inputs">
                    <input class="input" name="prdName" type="text" placeholder="Product Name" required>
                    <input class="input" name="quantity" type="number" placeholder="Product Quantity" required>
                    <input class="input" name="unit_price" type="number" placeholder="Product price" step=".01" required>
                </div>
            </div>
            <div class="buttonForm">
                <button id="submitBtn" type="submit">Submit</button>
                <a href=<%=links.cancel%>><button id="cancelBtn" type="button">Cancel</button></a>
            </div>
        </form>
    </div>
</body>
</html>